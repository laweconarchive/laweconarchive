{
  "name": "law-and-economics-academic-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "covers": "node scripts/generate-publication-covers.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "security:static": "node scripts/security-check.mjs",
    "security:deps": "npm audit --omit=dev --audit-level=high",
    "security:release": "node scripts/security-check.mjs --release && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fontsource/libre-baskerville": "5.3.0",
    "js-yaml": "^4.3.2",
    "next": "^16.4.0",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "minimatch": "10.2.6",
    "nanoid": "3.3.18",
    "postcss": "$postcss",
    "sharp": "0.35.5"
  }
}
